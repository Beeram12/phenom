# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Shared secret the frontend sends in the X-API-Key header. Change this.
API_KEY=dev-key-change-me

# Allowed frontend origins, comma-separated (e.g. http://localhost:5173). "*" allows all.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Kafka (Aiven for Apache Kafka, SASL over TLS)
# Leave KAFKA_BOOTSTRAP_SERVERS empty to write events to events_out.jsonl instead.
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka-182d885c-pranithreddy16-c8b4.c.aivencloud.com:28672
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=<aiven-password>
# CA certificate from the Aiven console (Connect information > CA certificate).
KAFKA_SSL_CA_LOCATION=ca.pem

# Optional: override topic names to match an existing setup, or publish everything to one topic.
# TOPIC_USER=events.user
# TOPIC_BROWSE=events.browse
# TOPIC_CART=events.cart
# TOPIC_PAYMENT=events.payment
# TOPIC_ORDER=events.order
# TOPIC_REVIEW=events.review
# TOPIC_DLQ=events.dlq
# KAFKA_SINGLE_TOPIC=
