# Base URL of the Food Events API (no trailing slash). Events are POSTed in batches to
# {NEXT_PUBLIC_EVENTS_API_URL}/api/v1/events/batch
NEXT_PUBLIC_EVENTS_API_URL=https://your-food-events-api.example.com

# Sent as the X-API-Key header. NEXT_PUBLIC_ values are embedded in the browser bundle,
# so use a write-only ingest key, never an admin key.
NEXT_PUBLIC_EVENTS_API_KEY=

# Optional: city tag and restaurant id sent with every event.
NEXT_PUBLIC_CITY=hyderabad
NEXT_PUBLIC_RESTAURANT_ID=r_saffron_sage

# Optional: set to "false" to hide the demo payment-outcome switch at checkout.
# When hidden, the mock gateway succeeds ~85% of the time.
NEXT_PUBLIC_SHOW_PAYMENT_SIMULATOR=true
